# Copy to .env.local. Never commit the copied file.
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=replace-with-local-anon-key

PAGE_DATA_VERSION=local-v1
PAGE_DATA_TIMEOUT_MS=5000

# Optional endpoint overrides. Leave blank to derive them from SUPABASE_URL.
PAGE_QUERY_EDGE_URL=
ROUTE_SEARCH_QUERY_EDGE_URL=
HOMEPAGE_STATISTICS_EDGE_URL=
FLIGHT_AFFILIATE_HANDOFF_EDGE_URL=
CITY_PAGE_EDGE_URL=

REVALIDATE_SECRET=replace-with-local-random-secret

# Copy to .env.production. Never commit the copied file.
APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://tripways.app

SUPABASE_URL=https://replace-with-production-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-production-publishable-key

PAGE_DATA_VERSION=production-v1
PAGE_DATA_TIMEOUT_MS=5000

# Optional endpoint overrides. Leave blank to derive them from SUPABASE_URL.
PAGE_QUERY_EDGE_URL=
ROUTE_SEARCH_QUERY_EDGE_URL=
HOMEPAGE_STATISTICS_EDGE_URL=
FLIGHT_AFFILIATE_HANDOFF_EDGE_URL=
CITY_PAGE_EDGE_URL=

REVALIDATE_SECRET=replace-with-production-random-secret

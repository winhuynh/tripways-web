# Copy to .env.staging. Never commit the copied file.
APP_ENV=staging
NEXT_PUBLIC_SITE_URL=https://staging.tripways.app

SUPABASE_URL=https://replace-with-staging-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-staging-publishable-key

PAGE_DATA_VERSION=staging-v1
PAGE_DATA_TIMEOUT_MS=5000

# Optional endpoint overrides. Leave blank to derive them from SUPABASE_URL.
PAGE_QUERY_EDGE_URL=
ROUTE_SEARCH_QUERY_EDGE_URL=
HOMEPAGE_STATISTICS_EDGE_URL=
FLIGHT_AFFILIATE_HANDOFF_EDGE_URL=
CITY_PAGE_EDGE_URL=

REVALIDATE_SECRET=replace-with-staging-random-secret
